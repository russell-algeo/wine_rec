{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@wine-rec/contracts": ["packages/contracts/src/index.ts"],
      "@wine-rec/core": ["packages/core/src/index.ts"]
    },
    "declaration": true,
    "sourceMap": true
  }
}
