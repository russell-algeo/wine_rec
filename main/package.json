{
  "name": "wine-rec-main",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev:api": "node --import tsx src/server.ts",
    "dev:api:watch": "tsx watch src/server.ts",
    "dev:web": "npm run dev --workspace @wine-rec/web",
    "build:packages": "npm run build --workspace @wine-rec/contracts && npm run build --workspace @wine-rec/core",
    "build:web": "npm run build --workspace @wine-rec/web",
    "vercel-build": "npm run build:packages && npm run build:web && rm -rf dist && mkdir -p dist && cp -R web/dist/. dist/",
    "test": "npm run build:packages && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @wine-rec/web"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@sparticuz/chromium-min": "^143.0.4",
    "@upstash/qstash": "^2.9.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.1",
    "@wine-rec/contracts": "0.1.0",
    "@wine-rec/core": "0.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.5",
    "playwright-core": "^1.58.2",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "vitest": "^3.0.8",
    "typescript": "^5.8.2"
  }
}
