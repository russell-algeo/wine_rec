{
  "name": "wine-rec-worker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "worker": "node --import tsx src/worker.ts",
    "worker:watch": "tsx watch src/worker.ts",
    "build:packages": "npm run build --workspace @wine-rec/contracts && npm run build --workspace @wine-rec/core",
    "vercel-build": "npm run build:packages",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@sparticuz/chromium-min": "^143.0.4",
    "@upstash/qstash": "^2.9.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.1",
    "@wine-rec/contracts": "0.1.0",
    "@wine-rec/core": "0.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.5",
    "playwright-core": "^1.58.2",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
