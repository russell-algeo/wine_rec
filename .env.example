PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
UPLOAD_ROOT=../shared/uploads
DATABASE_URL=../shared/data/wine-rec.sqlite
WORKER_POLL_INTERVAL_MS=1500
WORKER_CONCURRENCY=2
ANALYSIS_CANDIDATE_CONCURRENCY=3
SERVERLESS_WORKER_MAX_PARALLEL=10
SERVERLESS_WORKER_INITIAL_JITTER_MAX_SECONDS=3
SERVERLESS_WORKER_TIME_BUDGET_MS=50000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v143.0.4/chromium-v143.0.4-pack.x64.tar
VERCEL_AUTOMATION_BYPASS_SECRET=
# OCR_PROVIDER options: mock | tesseract-js | ocr-space | tesseract
OCR_PROVIDER=tesseract-js
OCR_SPACE_API_KEY=
WINE_PROFILE_PROVIDER_ORDER=vivino-direct,rule-based
ENABLE_VIVINO_DIRECT=true
VIVINO_DIRECT_USER_AGENT=
VIVINO_DIRECT_DELAY_MS=500
VIVINO_DIRECT_MAX_RETRIES=3
VIVINO_DIRECT_BACKOFF_MS=2000
VIVINO_DIRECT_FETCH_TASTES=true
VIVINO_DIRECT_HEADLESS=true
VIVINO_DIRECT_CHROME_EXECUTABLE=

# Shared-Upstash Preview: logical collision prevention, not access isolation.
# Production must leave these unset; keep its existing job:* keys unchanged.
# WINE_REC_NAMESPACE=preview:review-20261111
# WINE_REC_PREVIEW_ROLE=app
# Worker project uses WINE_REC_PREVIEW_ROLE=worker with the identical namespace.
# Both Preview roots also require an identical one-off smoke-test budget:
# WINE_REC_PREVIEW_PUBLISH_LIMIT=6
# WINE_REC_PREVIEW_EXPIRES_AT=<exact ISO UTC timestamp within the next 24 hours>
# Never reset/delete the namespace budget counter or raise the batch allowance.
# VERCEL_URL supplies each immutable self URL; app must also set the reviewed
# immutable Preview worker CHUNK_WORKER_BASE_URL (never a Production alias).
